{
  "problemMatcher": [
    {
      "owner": "emmylua-check",
      "pattern": [
        {
          "regexp": "^(error|warning): (.+)\\s+\\[([^\\]]+)\\]$",
          "severity": 1,
          "message": 2,
          "code": 3
        },
        {
          "regexp": "^\\s+-->\\s+(.+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    }
  ]
}
